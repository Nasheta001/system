# Environment for docker-compose (local production-like stack).
# Copy to deploy/docker.env (git-ignored) and replace every CHANGE_ME value,
# or run: powershell -ExecutionPolicy Bypass -File scripts\docker-env.ps1
POSTGRES_PASSWORD=CHANGE_ME
DATABASE_URL=postgres://propman:CHANGE_ME@db:5432/propman
DJANGO_DEBUG=false
DJANGO_SECRET_KEY=CHANGE_ME
FIELD_ENCRYPTION_KEYS=CHANGE_ME
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend
CSRF_TRUSTED_ORIGINS=http://localhost:8080
FRONTEND_URL=http://localhost:8080
# Local stack is plain HTTP. In AWS this MUST be true.
SECURE_HTTPS=false
NUM_PROXIES=1
CACHE_BACKEND=db
STORAGE_BACKEND=local
LOG_FORMAT=json
MPESA_MODE=simulated
MPESA_CALLBACK_TOKEN=CHANGE_ME
NOTIFY_EMAIL_ENABLED=false
SMS_PROVIDER=log
WHATSAPP_PROVIDER=log
