# Copy to backend/.env and adjust. NEVER commit the real .env file.

# --- Core --------------------------------------------------------------------
DJANGO_DEBUG=true
DJANGO_SECRET_KEY=replace-with-a-long-random-string
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:4200,http://127.0.0.1:4200
# Only needed if the Angular app is served from a different origin (no proxy):
CORS_ALLOWED_ORIGINS=
FRONTEND_URL=http://localhost:4200
TIME_ZONE=Africa/Nairobi
# Set to true in production behind HTTPS (secure __Host- cookies, HSTS, redirect)
SECURE_HTTPS=false
SECURE_HSTS_PRELOAD=false
# Trusted reverse proxies that append X-Forwarded-For (CloudFront + ALB = 2, nginx = 1, none = 0)
NUM_PROXIES=0
# Shared secret CloudFront sends as X-Origin-Verify; requests without it are rejected (empty = off)
ORIGIN_VERIFY_SECRET=

# --- Encryption of sensitive fields (national ID numbers) ---------------------
# Comma-separated Fernet keys; first one encrypts. REQUIRED when DJANGO_DEBUG=false.
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FIELD_ENCRYPTION_KEYS=

# --- Login protection & bot protection -----------------------------------------
LOGIN_MAX_FAILURES=5
LOGIN_LOCKOUT_MINUTES=15
# Optional Cloudflare Turnstile (https://dash.cloudflare.com -> Turnstile). Empty = honeypot only.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- Invitation-only accounts ------------------------------------------------------
# Invitation links are single-use and expire after this many hours.
INVITATION_TTL_HOURS=72
# One-time /account/setup page (works only while no administrator exists). With DJANGO_DEBUG=false it
# needs this token; leave EMPTY to disable it and create the first admin with `manage.py createsuperuser`.
SETUP_TOKEN=
THROTTLE_INVITATION=20/hour

# --- Cache (rate limits, lock-outs, worker heartbeat) ------------------------------
# locmem = single process (development); db = shared PostgreSQL table (production; run createcachetable)
CACHE_BACKEND=locmem

# --- Logging -----------------------------------------------------------------------
# text | json (one JSON object per line, for CloudWatch)
LOG_FORMAT=text

# --- Database (PostgreSQL) ---------------------------------------------------
# postgres://USER:PASSWORD@HOST:PORT/DBNAME
# If left empty, a local SQLite file is used (quick trials only).
DATABASE_URL=postgres://propman:change-me@localhost:5432/propman
# Alternative used on AWS (password injected from the RDS-managed secret):
# DB_HOST= DB_PORT=5432 DB_NAME=propman DB_USER=propman DB_PASSWORD=
DB_SSL_REQUIRE=false

# --- Files -------------------------------------------------------------------
# local (filesystem) or s3
STORAGE_BACKEND=local
# MEDIA_ROOT=C:/propman/media
# PRIVATE_MEDIA_ROOT=C:/propman/private_media
# With STORAGE_BACKEND=s3 (credentials come from the IAM role - never put access keys here):
# AWS_STORAGE_BUCKET_NAME=      public property photos (served via CloudFront /media/)
# AWS_PRIVATE_BUCKET_NAME=      private documents (never public)
# AWS_S3_REGION_NAME=af-south-1
# AWS_S3_CUSTOM_DOMAIN=www.example.co.ke
MAX_UPLOAD_MB=10

# --- Email -------------------------------------------------------------------
# Notifications are only sent externally when NOTIFY_EMAIL_ENABLED=true.
NOTIFY_EMAIL_ENABLED=false
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
DEFAULT_FROM_EMAIL=no-reply@example.co.ke

# --- SMS (Africa's Talking) ----------------------------------------------------
# SMS_PROVIDER=log keeps messages in the notification log only.
SMS_PROVIDER=log
AFRICASTALKING_USERNAME=sandbox
AFRICASTALKING_API_KEY=
AFRICASTALKING_SENDER_ID=
AFRICASTALKING_SANDBOX=true

# --- WhatsApp (Meta WhatsApp Cloud API) -------------------------------------------
WHATSAPP_PROVIDER=log
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# --- M-Pesa Daraja -------------------------------------------------------------------
# disabled | simulated | sandbox | production
MPESA_MODE=simulated
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=174379
MPESA_PASSKEY=
MPESA_TRANSACTION_TYPE=CustomerPayBillOnline
# Public HTTPS base URL that Safaricom can reach (e.g. an ngrok URL in sandbox)
MPESA_CALLBACK_BASE_URL=
# Long random secret embedded in the callback URL path
MPESA_CALLBACK_TOKEN=replace-with-a-long-random-string
# Optional comma-separated allow-list of Safaricom callback IPs
MPESA_ALLOWED_CALLBACK_IPS=
MPESA_TIMEOUT_MINUTES=10
